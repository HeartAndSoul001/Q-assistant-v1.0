*{
    font: 10px "Courier New";
}


QListWidget{
    background-color: rgb(225,225,225); 
    border-radius:10px; 
    font: bold 15px "Courier New";
}

QListWidget::item{
    text-align: center;
    padding:2px 4px;
    min-height: 50px;
    margin: 5px;
}

QListWidget::item:hover{
    background-color: rgb(230,230,250);
}

QListWidget::item:pressed{
    background-color: rgb(176,196,222);
}

QListWidget::item:checked{
    background-color: rgba(100, 113, 131, 255);
}

QPushButton{
    background-color:rgb(225,225,225); 
    border:2px groove gray; 
    border-radius:10px;
    padding:2px 4px;
    border-style:outset;
    font: bold 12px "Courier New";
}

QPushButton:hover {
    background-color: rgb(230,230,250);
    color:black;
}

QPushButton:pressed {
    background-color: rgb(176,196,222);
    border-style: inset;
}

QHeaderView{
    font: bold 10px "Courier New";
    /* border: 2px solid gray; */
    border-radius: 10px;
}

QHeaderView::section{
    color: white;
    background: qlineargradient(x1:0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #616161, stop: 0.5 #505050,
                                stop: 0.6 #434343, stop: 1.0 #656565);
    border-top: 1px solid black;
    border-bottom: 1px solid black;
    font: bold 12px;
}


QTableView {
    margin: 0;
    padding: 0;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    gridline-color: #d0d0d0;
    color: black;
    background-color: white;
    selection-background-color: rgba(65, 67, 71, 255);
}

QTableView::item {
    padding: 4px;
}

QTableView::item:hover {
    background-color: rgba(169, 169, 203, 255);
}

QTableView::item:selected {
    background-color: rgba(65, 67, 71, 255);
    color: white;
}


QTabWidget::pane{
    border-top: 2px solid #C2C7CB;
}

QTabBar::tab{
    font: bold 12px "Courier New";
    background: qlineargradient(x1:0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #E1E1E1, stop: 0.4 #DDDDDD,
                                stop: 0.5 #D8D8D8, stop: 1.0 #D3D3D3);
    border: 2px solid #C4C4C3;
    border-bottom-color: #C2C7CB;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 8ex;
    padding: 2px;
}

QTabBar::tab:selected, QTabBar::tab:hover{
background: qlineargradient(x1:0, y1: 0, x2: 0, y2: 1,
                            stop: 0 #FAFAFA, stop: 0.4 #F4F4F4,
                            stop: 0.5 #E7E7E7, stop: 1.0 #FAFAFA);
}

QTabBar::tab:selected{
    border-color: #9B9B9B;
    border-bottom-color: #C2C7CB;
}

QTabBar::tab:!selected{
    margin-top: 2px;
}

QComboBox{
    border: 1px solid gray;
    border-radius: 3px;
    padding: 1px 2px 1px 2px;
    min-width: 2em;
    font: bold 12px "Courier New";
}

QComboBox::drop-down{
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;

    border-left-width: 1px;
    border-left-color: darkgray;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    image: url(./resources/images/downbtn.png);
}

QLabel{
    font: bold "Courier New";
}

QLineEdit{
    border: 2px solid gray;
    border-radius: 10px;
    padding: 0 8px;
    selection-background-color: darkgray;
}

QPlainTextEdit{
    border: 2px solid gray;
    border-radius: 10px;
    padding: 0 8px;
    selection-background-color: darkgray;
    font: bold 14px "Courier New";
}

QPlainTextEdit:read-only{
    color: black;
    background-color: darkgray;
    font: bold 12px "Courier New";
    border: 2px solid gray;
    border-radius: 10px;
    padding: 0 8px;
    selection-background-color: darkgray;
}


/* 代码编辑器容器 */
#codeEditor {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 4px;
}

/* 行号区域样式 */
#codeEditor #numberArea {
    width: 40px;
    background-color: #f0f0f0;
    border-right: 1px dashed #dddddd;
}

/* 行号 ListView 样式 */
#codeEditor #numberListView {
    background-color: transparent;
}

/* 行号文本样式 */
#codeEditor #numberListView Text {
    color: #666666;
    font-size: 14px;
    padding: 5px;
}

/* 代码编辑器样式 */
#codeEditorTextEdit {
    placeholder-text: "请输入代码...";
    font-size: 14px;
    background-color: #ffffff;
    border: 1px solid #dddddd;
}

#codeEditorTextEdit:focus {
    placeholder-text: "";
}