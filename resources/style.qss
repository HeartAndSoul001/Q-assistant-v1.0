/* 小Q助手 - 现代 UI 样式表 */
/* 主字体：微软雅黑 UI，兼顾中文与界面美感 */
* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13px;
}

/* 主窗口背景 */
QWidget {
    background-color: #f1f5f9;
}

/* ========== 左侧导航栏（可收起） ========== */
QFrame#mainNavContainer {
    background-color: #374151;
    border: none;
    border-right: 2px solid #4b5563;
    border-radius: 0;
}

QListWidget#mainNav {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 12px 0;
    outline: none;
}

QListWidget#mainNav::item {
    color: #d1d5db;
    text-align: center;
    padding: 14px 16px;
    min-height: 48px;
    margin: 4px 12px;
    border-radius: 8px;
    border: none;
}

QListWidget#mainNav::item:hover {
    background-color: #4b5563;
    color: #ffffff;
}

QListWidget#mainNav::item:selected,
QListWidget#mainNav::item:checked {
    background-color: #3b82f6;
    color: #ffffff;
}

QPushButton#navToggleBtn {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #4b5563;
    border-radius: 0;
    padding: 12px;
    color: #d1d5db;
    text-align: center;
}

QPushButton#navToggleBtn:hover {
    background-color: #4b5563;
    color: #ffffff;
}

QPushButton#navToggleBtn:pressed {
    background-color: #6b7280;
}

/* ========== 内容区域容器 ========== */
QWidget#contentStack {
    background-color: #ffffff;
    border-radius: 12px;
    margin: 12px;
}

/* ========== 按钮 ========== */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
    color: #334155;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
    color: #1e293b;
}

QPushButton:pressed {
    background-color: #e2e8f0;
    border-color: #94a3b8;
}

QPushButton:focus {
    outline: none;
}

/* 主操作按钮 */
QPushButton#primaryButton {
    background-color: #3b82f6;
    border-color: #3b82f6;
    color: #ffffff;
}

QPushButton#primaryButton:hover {
    background-color: #2563eb;
    border-color: #2563eb;
}

QPushButton#primaryButton:pressed {
    background-color: #1d4ed8;
}

/* ========== 表格 ========== */
QHeaderView {
    font-weight: 600;
    font-size: 12px;
    border: none;
    border-radius: 0;
}

QHeaderView::section {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #475569, stop:1 #334155);
    padding: 10px 12px;
    border: none;
    border-right: 1px solid #475569;
}

QHeaderView::section:last {
    border-right: none;
}

QTableView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    color: #334155;
    padding: 0;
}

QTableView::item {
    padding: 10px 12px;
}

QTableView::item:hover {
    background-color: #f8fafc;
}

QTableView::item:selected {
    background-color: #dbeafe;
    color: #1e40af;
}

/* ========== 选项卡 ========== */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-top: none;
    border-radius: 0 0 8px 8px;
    background-color: #ffffff;
    top: -1px;
    padding: 16px;
}

QTabBar::tab {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 10px 20px;
    margin-right: 4px;
    font-weight: 500;
    color: #64748b;
}

QTabBar::tab:hover {
    background-color: #e2e8f0;
    color: #334155;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #3b82f6;
    border-color: #e2e8f0;
    border-bottom: 1px solid #ffffff;
    margin-bottom: -1px;
}

/* ========== 下拉框 ========== */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 12px;
    min-width: 100px;
    font-weight: 500;
}

QComboBox:hover {
    border-color: #cbd5e1;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    border-left: 1px solid #e2e8f0;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    image: url(./resources/images/downbtn.png);
}

/* ========== 标签 ========== */
QLabel {
    font-weight: 500;
    color: #334155;
}

/* ========== 单行输入框 ========== */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: #bfdbfe;
}

QLineEdit:hover {
    border-color: #cbd5e1;
}

QLineEdit:focus {
    border-color: #3b82f6;
}

QLineEdit:read-only {
    background-color: #f8fafc;
    color: #64748b;
}

/* ========== 多行文本 / 代码编辑器 ========== */
QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px;
    font-family: "Consolas", "Microsoft YaHei UI", monospace;
    font-size: 13px;
    selection-background-color: #bfdbfe;
}

QPlainTextEdit:hover {
    border-color: #cbd5e1;
}

QPlainTextEdit:focus {
    border-color: #3b82f6;
}

QPlainTextEdit:read-only {
    background-color: #f8fafc;
    color: #475569;
}

/* 代码编辑器容器 */
#codeEditor {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

#codeEditor #numberArea {
    width: 40px;
    background-color: #f8fafc;
    border-right: 1px solid #e2e8f0;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
}

#codeEditor #numberListView {
    background-color: transparent;
}

#codeEditor #numberListView Text {
    color: #94a3b8;
    font-size: 12px;
}

#codeEditorTextEdit {
    placeholder-text: "请输入代码...";
    font-size: 13px;
    background-color: #ffffff;
    border: none;
}

/* ========== 功能性框架 (myComboBox 等) ========== */
QFrame {
    background-color: transparent;
}
